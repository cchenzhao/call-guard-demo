{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python", "config": {"maxLambdaSize": "500mb", "excludeFiles": "{public/**,scripts/**,tests/**,.git/**}"}},
    {"src": "public/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.py"},
    {"src": "/", "dest": "/public/index.html"},
    {"src": "/(.*)", "dest": "/public/$1"}
  ]
}
